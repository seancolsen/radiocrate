# Generated by Cargo
# will have compiled files and executables
/target/
backend/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock is checked in for the backend executable

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by `bun run build` (Vite) — the Solid frontend's output, embedded
# into the production binary at build time. The .gitkeep placeholder keeps the
# directory present so `rust-embed` doesn't fail before the first Vite build on
# a fresh checkout.
/frontend/dist/*
!/frontend/dist/.gitkeep

# Reference egui builds (frontend-old-egui) — embedded by nothing.
/frontend-old-egui/dist/

# New SolidJS frontend transients.
/frontend/node_modules/
# The Querydown JS binding (querydown-js) is a wasm-pack build artifact,
# regenerated by `cargo xtask build-release` (and manually in dev via
# `wasm-pack build bindings/js --target web` on a pinned Querydown checkout).
/frontend/vendor/querydown-js/
/frontend/dev-dist/
/frontend/test-results/
/frontend/playwright-report/
# Playwright's transient screenshot artifact (baselines under __screenshots__/
# are committed; diffs are covered by the *.diff.png rule below).
*-actual.png

# Transient egui_kittest snapshot artifacts, rewritten/cleaned on every test run.
# Only the `*.png` baselines are committed; these are throwaway:
#   *.new.png  — the freshly rendered image when a test fails
#   *.diff.png — a visual diff highlighting the changed pixels
#   *.old.png  — a backup of the previous baseline after UPDATE_SNAPSHOTS rewrote it
#   *.composite.png — an old|diff|new strip from scripts/snapshot_composite.sh
*.new.png
*.diff.png
*.old.png
*.composite.png

# Python bytecode cache (e.g. from running scripts/measure_snapshot.py).
__pycache__/
*.pyc

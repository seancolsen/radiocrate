{
  "name": "radiocrate-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit -p tsconfig.solid.json && tsgo --noEmit -p tsconfig.react.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "apache-arrow": "^18.0.0",
    "immer": "^11.1.18",
    "querydown-js": "file:./vendor/querydown-js",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.14",
    "track-lineage": "file:./vendor/track-lineage",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@iconify-json/material-symbols": "^1.2.86",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.1",
